{
  "comment": "Single source of truth for the native messaging protocol's wire vocabulary. docs/protocol.md is the prose specification; tests/native_host.rs and tests/extension/task-protocol.test.js both read this file so the Rust host and the JavaScript client cannot drift apart silently.",
  "protocol_version": 1,
  "legacy_protocol_version": 0,
  "max_message_bytes": 1048576,
  "commands": [
    "hello",
    "download",
    "pause",
    "resume",
    "cancel",
    "hls-info",
    "status"
  ],
  "event_types": [
    "hello",
    "ack",
    "progress",
    "log",
    "terminal",
    "rejected",
    "control-error",
    "status"
  ],
  "job_states": {
    "active": [
      "starting",
      "downloading",
      "paused",
      "cancelling"
    ],
    "terminal": [
      "completed",
      "failed",
      "cancelled"
    ],
    "extension_only": [
      "preparing",
      "interrupted"
    ]
  },
  "connection_states": [
    "ready",
    "rejected",
    "control-error"
  ],
  "error_codes": [
    "invalid_request",
    "unsupported_command",
    "unsupported_protocol_version",
    "duplicate_job",
    "host_busy",
    "task_not_active",
    "control_failed",
    "invalid_hls_info",
    "download_failed",
    "resume_failed",
    "cancelled"
  ],
  "max_downloads_per_connection": 1,
  "capabilities": [
    "pause_resume",
    "hls_info"
  ],
  "on_conflict_policies": [
    "fail",
    "rename",
    "overwrite"
  ],
  "default_on_conflict": "rename",
  "default_keep_partial": false,
  "check_outcomes": [
    "pass",
    "warn",
    "fail"
  ],
  "check_names": [
    "host_registration",
    "ffmpeg",
    "output_directory"
  ]
}
