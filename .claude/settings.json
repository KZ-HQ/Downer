{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__Linear",
      "mcp__linear",
      "mcp__linear-server",
      "mcp__claude_ai_linear",
      "mcp__claude_ai_Linear"
    ],
    "ask": [
      "mcp__*__delete_*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session_start.sh"
          }
        ]
      }
    ]
  }
}
